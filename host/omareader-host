#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Native messaging host: push the active Omarchy palette to Omareader."""

import json
import os
import select
import struct
import sys
import threading
import time
import tomllib
from pathlib import Path

IN_CLOSE_WRITE = 0x00000008
IN_MOVED_FROM = 0x00000040
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_Q_OVERFLOW = 0x00004000
IN_IGNORED = 0x00008000
WATCH_MASK = (
    IN_CLOSE_WRITE
    | IN_MOVED_FROM
    | IN_MOVED_TO
    | IN_CREATE
    | IN_DELETE
    | IN_DELETE_SELF
    | IN_MOVE_SELF
)
DEBOUNCE_SECONDS = 0.2
STATE = Path(
    os.environ.get("OMAREADER_STATE_DIR", Path.home() / ".local/state/omarchy")
)
CURRENT = STATE / "current"

import ctypes

_libc = ctypes.CDLL("libc.so.6", use_errno=True)
_libc.inotify_init1.argtypes = [ctypes.c_int]
_libc.inotify_init1.restype = ctypes.c_int
_libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
_libc.inotify_add_watch.restype = ctypes.c_int
_libc.inotify_rm_watch.argtypes = [ctypes.c_int, ctypes.c_int]
_libc.inotify_rm_watch.restype = ctypes.c_int

_write_lock = threading.Lock()
_stop = threading.Event()
_last_sent = ""


def write_message(payload):
    data = json.dumps(payload, separators=(",", ":")).encode()
    header = struct.pack("<I", len(data))
    with _write_lock:
        sys.stdout.buffer.write(header)
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()


def read_message():
    header = sys.stdin.buffer.read(4)
    if len(header) < 4:
        return None
    size = struct.unpack("<I", header)[0]
    if size > 1_048_576:
        return None
    body = sys.stdin.buffer.read(size)
    if len(body) < size:
        return None
    return json.loads(body)


def normalize_hex(value):
    if not isinstance(value, str):
        return None
    text = value.strip().lower()
    if not text.startswith("#"):
        return None
    digits = text[1:]
    if len(digits) == 3 and all(char in "0123456789abcdef" for char in digits):
        digits = "".join(char * 2 for char in digits)
    if len(digits) == 8:
        digits = digits[:6]
    if len(digits) != 6 or any(char not in "0123456789abcdef" for char in digits):
        return None
    return f"#{digits}"


def luminance(color):
    def channel(pair):
        value = int(pair, 16) / 255
        if value <= 0.04045:
            return value / 12.92
        return ((value + 0.055) / 1.055) ** 2.4

    red = channel(color[1:3])
    green = channel(color[3:5])
    blue = channel(color[5:7])
    return 0.2126 * red + 0.7152 * green + 0.0722 * blue


def read_palette():
    colors_path = CURRENT / "theme" / "colors.toml"
    name_path = CURRENT / "theme.name"
    if not colors_path.is_file():
        raise ValueError(f"missing {colors_path}")
    with colors_path.open("rb") as handle:
        colors = tomllib.load(handle)
    background = normalize_hex(colors.get("background"))
    foreground = normalize_hex(colors.get("foreground"))
    if not background or not foreground:
        raise ValueError("colors.toml needs background and foreground")
    selection = normalize_hex(colors.get("selection")) or normalize_hex(
        colors.get("selection_background")
    )
    mode = colors.get("mode")
    if mode not in ("light", "dark"):
        mode = "light" if luminance(background) > 0.5 else "dark"
    theme = ""
    if name_path.is_file():
        theme = name_path.read_text(encoding="utf-8").strip()
    return {
        "type": "palette",
        "theme": theme,
        "mode": mode,
        "background": background,
        "foreground": foreground,
        "selection": selection or "",
    }


def publish(force=False):
    global _last_sent
    try:
        palette = read_palette()
    except (OSError, ValueError, tomllib.TOMLDecodeError) as error:
        message = str(error)
        if force or message != _last_sent:
            _last_sent = message
            write_message({"type": "error", "message": message})
        return
    encoded = json.dumps(palette, sort_keys=True)
    if not force and encoded == _last_sent:
        return
    _last_sent = encoded
    write_message(palette)


class Watcher:
    def __init__(self):
        flags = os.O_NONBLOCK | os.O_CLOEXEC
        self.fd = _libc.inotify_init1(flags)
        if self.fd < 0:
            err = ctypes.get_errno()
            raise OSError(err, os.strerror(err))
        self._watches = []

    def reset(self):
        for watch in self._watches:
            _libc.inotify_rm_watch(self.fd, watch)
        self._watches.clear()
        for path in (CURRENT, CURRENT / "theme"):
            if not path.is_dir():
                continue
            watch = _libc.inotify_add_watch(self.fd, os.fsencode(path), WATCH_MASK)
            if watch >= 0:
                self._watches.append(watch)

    def consume(self):
        try:
            data = os.read(self.fd, 65536)
        except BlockingIOError:
            return False
        dirty = False
        offset = 0
        while offset + 16 <= len(data):
            _wd, mask, _cookie, name_len = struct.unpack_from("iIII", data, offset)
            offset += 16 + name_len
            if mask & (IN_Q_OVERFLOW | IN_IGNORED | WATCH_MASK):
                dirty = True
        return dirty


def stdin_loop():
    while not _stop.is_set():
        try:
            message = read_message()
        except json.JSONDecodeError:
            continue
        if message is None:
            _stop.set()
            return
        if isinstance(message, dict) and message.get("type") == "hello":
            publish(force=True)


def serve():
    watcher = Watcher()
    watcher.reset()
    publish(force=True)
    thread = threading.Thread(target=stdin_loop, daemon=True)
    thread.start()
    pending_at = None
    while not _stop.is_set():
        timeout = 0.2
        if pending_at is not None:
            timeout = max(0.0, DEBOUNCE_SECONDS - (time.monotonic() - pending_at))
        ready, _, _ = select.select([watcher.fd], [], [], timeout)
        if ready and watcher.consume():
            pending_at = time.monotonic()
            continue
        if pending_at is None or time.monotonic() - pending_at < DEBOUNCE_SECONDS:
            continue
        watcher.reset()
        publish()
        pending_at = None


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--dump":
        json.dump(read_palette(), sys.stdout)
        sys.stdout.write("\n")
        return
    try:
        serve()
    except BrokenPipeError:
        return


if __name__ == "__main__":
    main()
