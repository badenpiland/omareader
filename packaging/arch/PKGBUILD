# Maintainer: Baden Piland <github@ps.pilandcloud.com>
pkgname=omareader-bin
_pkg=omareader
pkgver=0.3.1
pkgrel=1
pkgdesc="Restyle Chromium pages with the active Omarchy theme (extension + native host)"
arch=('any')
url="https://github.com/badenpiland/omareader"
license=('MIT')
depends=('python>=3.11')
makedepends=('git')
optdepends=('chromium: Chromium (or omarchy-chromium-bin)'
            'google-chrome: Google Chrome (AUR)'
            'brave-bin: Brave (AUR)'
            'brave-origin-bin: Brave Origin (AUR)'
            'microsoft-edge-stable-bin: Microsoft Edge (AUR)')
provides=("$_pkg")
conflicts=("$_pkg")
_extid=mhglniaepbokfgnpeennihlifandcgjh
source=("$_pkg::git+$url.git#tag=v$pkgver"
        "$_pkg-$pkgver.crx::$url/releases/download/v$pkgver/omareader.crx")
sha256sums=('f240ada159b973b5cf5cceca4d83524ffbda86fe73a1ce03e4b34707df950d02'
            '7c777f1841afa64f2eaef669a039f245b2b9ea359582c693a5decf975c1028ba')
# makepkg treats a CRX as a zip. Leave the signed file intact.
noextract=("${_pkg}-${pkgver}.crx")

prepare() {
  # The CRX is already signed. Refuse a build whose manifest version is not pkgver.
  local ver
  ver="$(bsdtar -xOf "$srcdir/${_pkg}-${pkgver}.crx" manifest.json | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  if [[ "$ver" != "$pkgver" ]]; then
    printf 'CRX manifest version %s does not match pkgver %s\n' "$ver" "$pkgver" >&2
    exit 1
  fi
}

package() {
  install -Dm755 "$_pkg/host/omareader-host" "$pkgdir/usr/lib/$_pkg/omareader-host"
  install -Dm644 "$_pkg-$pkgver.crx" "$pkgdir/usr/share/$_pkg/omareader.crx"

  local ext host d
  ext=$(printf '{\n  "external_crx": "/usr/share/%s/omareader.crx",\n  "external_version": "%s"\n}\n' "$_pkg" "$pkgver")
  host=$(printf '{\n  "name": "com.bhp.omareader",\n  "description": "Omareader Omarchy theme host",\n  "path": "/usr/lib/%s/omareader-host",\n  "type": "stdio",\n  "allowed_origins": ["chrome-extension://%s/"]\n}\n' "$_pkg" "$_extid")

  # Chromium's directory also serves Brave and Brave Origin.
  for d in /usr/share/chromium/extensions /usr/share/google-chrome/extensions /usr/share/microsoft-edge/extensions; do
    install -dm755 "$pkgdir$d"
    printf '%s\n' "$ext" > "$pkgdir$d/$_extid.json"
  done
  # Brave and Brave Origin read Chrome's host directory, not /etc/brave.
  for d in /etc/chromium/native-messaging-hosts /etc/opt/chrome/native-messaging-hosts /etc/opt/edge/native-messaging-hosts; do
    install -dm755 "$pkgdir$d"
    printf '%s\n' "$host" > "$pkgdir$d/com.bhp.omareader.json"
  done

  install -Dm644 "$_pkg/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$_pkg"/LICENSES/*.txt
}
